@model ZooOptions
@{
    ViewData["Title"] = "Демо-доступы";
}

<div class="container">
    <header class="zoo-page-head">
        <div>
            <h1>Логины и пароли для проверки</h1>
            <p class="zoo-muted">
                Учётные записи создаются автоматически при первом запуске приложения (инициализация БД).
                Эти же данные указаны в README.md проекта.
            </p>
        </div>
    </header>

    <div class="zoo-section zoo-section--split">
        <section class="zoo-card">
            <h2>Работник зоопарка (роль Staff)</h2>
            <ul class="zoo-kv">
                <li><span>Логин (e-mail)</span><code>keeper@zoostav.ru</code></li>
                <li><span>Пароль</span><code>Keeper#2026</code></li>
                <li><span>Имя</span><span>Смотритель вольера Енотов</span></li>
            </ul>
            <p class="zoo-muted small">
                Может: смотреть страницу животного, читать и <strong>вести</strong> дневник (создание, правка, удаление),
                работать с API-методами записи, просматривать журнал действий и управлять пользователями.
            </p>
            <a class="btn btn-accent" asp-action="Login">Войти как работник</a>
        </section>

        <section class="zoo-card">
            <h2>Посетитель (роль Visitor)</h2>
            <ul class="zoo-kv">
                <li><span>Логин (e-mail)</span><code>visitor@zoostav.ru</code></li>
                <li><span>Пароль</span><code>Visitor#2026</code></li>
                <li><span>Имя</span><span>Посетитель Иван</span></li>
            </ul>
            <p class="zoo-muted small">
                Может: смотреть описание, историю, фото, видео, веб-камеру, делать донаты и читать дневник.
                При попытке записать в дневник получит страницу «Доступ запрещён» (403).
            </p>
            <a class="btn btn-accent" asp-action="Login">Войти как посетитель</a>
        </section>
    </div>

    <section class="zoo-card">
        <h2>Как проверить JWT-аутентификацию API</h2>
        <pre class="zoo-code"># 1. Получить токен сотрудника
curl -X POST "@Url.Action("Login", "ApiAuth", new { area = "" })" -H "Content-Type: application/json" -d "{\"email\":\"keeper@zoostav.ru\",\"password\":\"Keeper#2026\"}"

# 2. Добавить запись в дневник (нужна роль Staff)
curl -X POST "/api/animals/raccoon/diary" \
  -H "Authorization: Bearer &lt;accessToken&gt;" -H "Content-Type: application/json" \
  -d "{\"type\":\"Feeding\",\"title\":\"Вечернее кормление\",\"description\":\"90 г рыбы\",\"performedBy\":\"Смотритель\"}"

# 3. Прочитать дневник с фильтрами (публично)
curl "/api/animals/raccoon/diary?type=Vaccination&dateFrom=2026-01-01&sort=date_desc&pageSize=5"

# 4. Проверить, что гость не может писать: без токена вернётся 401
curl -X POST "/api/animals/raccoon/diary" -H "Content-Type: application/json" -d "{\"title\":\"test\"}"</pre>

        <div class="zoo-api-links">
            <a class="btn btn-accent" href="/swagger" target="_blank">Открыть Swagger UI</a>
            <a class="btn btn-outline" asp-controller="Animal" asp-action="Routing">Роутинг поддомена</a>
            <a class="btn btn-outline" href="@Model.MainSiteUrl" target="_blank" rel="noopener">Главная зоопарка</a>
        </div>
    </section>
</div>
