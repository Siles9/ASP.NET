@model List<AuditLog>
@{
    ViewData["Title"] = "Журнал действий";
    var actions = ViewBag.Actions as List<string> ?? new List<string>();
    var selectedAction = ViewBag.Action as string;
    bool? selectedSuccess = ViewBag.Success as bool?;
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var total = (int)(ViewBag.Total ?? 0);
}

<div class="container">
    <header class="zoo-page-head">
        <div>
            <h1>Журнал действий</h1>
            <p class="zoo-muted">
                Раздел доступен только роли <code>Staff</code>. Всего записей: @total.
                Фиксируются входы, регистрации, работа с дневником, донаты и отказы в доступе.
            </p>
        </div>
    </header>

    <section class="zoo-card zoo-filter">
        <form method="get" class="zoo-filter__form">
            <div class="zoo-filter__row">
                <label>
                    <span>Действие</span>
                    <select name="action">
                        <option value="">— все действия —</option>
                        @foreach (var item in actions)
                        {
                            <option value="@item" selected="@(selectedAction == item)">@item</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Результат</span>
                    <select name="success">
                        <option value="">— любой —</option>
                        <option value="true" selected="@(selectedSuccess == true)">Успешно</option>
                        <option value="false" selected="@(selectedSuccess == false)">Ошибка / отказ</option>
                    </select>
                </label>
                <div class="zoo-filter__buttons">
                    <button type="submit" class="btn btn-accent">Показать</button>
                    <a class="btn btn-outline" asp-action="Audit">Сбросить</a>
                </div>
            </div>
        </form>
    </section>

    <div class="zoo-table-wrap">
        <table class="zoo-table zoo-table--compact">
            <thead>
            <tr>
                <th>Время (UTC)</th>
                <th>Действие</th>
                <th>Результат</th>
                <th>Пользователь</th>
                <th>Роль</th>
                <th>IP</th>
                <th>Детали</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var log in Model)
            {
                <tr class="@(log.Success ? "" : "zoo-row--error")">
                    <td>@log.TimestampUtc.ToString("dd.MM.yyyy HH:mm:ss")</td>
                    <td><code>@log.Action</code></td>
                    <td>@(log.Success ? "✔" : "✘")</td>
                    <td>@(log.UserName ?? "—")</td>
                    <td>@(log.Role ?? "—")</td>
                    <td>@(log.IpAddress ?? "—")</td>
                    <td class="zoo-muted">@log.Details</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav class="zoo-pagination">
            @for (var i = 1; i <= totalPages; i++)
            {
                <a class="btn btn-sm @(i == page ? "btn-accent" : "btn-outline")"
                   asp-action="Audit" asp-route-action="@selectedAction" asp-route-success="@selectedSuccess" asp-route-page="@i">@i</a>
            }
        </nav>
    }

    @if (!Model.Any())
    {
        <div class="zoo-card zoo-empty"><p>Записей журнала не найдено.</p></div>
    }
</div>
