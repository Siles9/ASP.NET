@using Microsoft.Extensions.Options
@inject IOptions<ZooOptions> ZooConfig
@{
    ViewData["Title"] = "О проекте";
    var zoo = ZooConfig.Value;
}

<div class="container">
    <header class="zoo-page-head">
        <h1>О проекте</h1>
        <p class="zoo-muted">
            Учебное веб-приложение «Страница животного зоопарка» (вариант — <strong>Енот</strong>),
            выполненное на ASP.NET Core MVC с REST API, JWT-аутентификацией и базой данных.
        </p>
    </header>

    <div class="zoo-section zoo-section--split">
        <section class="zoo-card">
            <h2>Что реализовано</h2>
            <ul class="zoo-list">
                <li>Страница животного на поддомене <code>raccoon.@zoo.RootDomain</code>, ссылка на главную зоопарка <a href="@zoo.MainSiteUrl" target="_blank" rel="noopener">@zoo.MainSiteUrl</a></li>
                <li>Обязательная ссылка на главную страницу зоопарка — в шапке, на странице животного, в подвале</li>
                <li>Аутентификация и авторизация: cookie для сайта, JWT для API, роли <code>Visitor</code> и <code>Staff</code></li>
                <li>Информация для посетителей: описание и история особи, фото, видео, веб-камера, донат</li>
                <li>Дневник особи для работников: кормёжка, вакцинация, спаривание, потомство, болезни, лечение и др.</li>
                <li>Фильтрация дневника по дате, типу, автору записи, животному и текстовому поиску</li>
                <li>REST API + Swagger UI, хранение данных в БД через EF Core (SQL Server / SQLite)</li>
                <li>Реальное время: новые записи дневника приходят на открытую страницу животного (SignalR)</li>
            </ul>
        </section>

        <section class="zoo-card">
            <h2>Стек</h2>
            <ul class="zoo-kv">
                <li><span>Платформа</span><code>ASP.NET Core 8.0 (MVC)</code></li>
                <li><span>Доступ к данным</span><code>EF Core 8 + миграции</code></li>
                <li><span>СУБД</span><code>SQL Server (по умолчанию), SQLite (демо)</code></li>
                <li><span>Аутентификация</span><code>Identity + Cookie + JWT Bearer</code></li>
                <li><span>Документация API</span><code>Swagger / OpenAPI</code></li>
                <li><span>Реальное время</span><code>SignalR</code></li>
                <li><span>Тесты</span><code>xUnit</code></li>
            </ul>
            <div class="zoo-api-links">
                <a class="btn btn-accent" href="/swagger" target="_blank">Swagger UI</a>
                <a class="btn btn-outline" href="/health" target="_blank">/health</a>
                <a class="btn btn-outline" asp-controller="Account" asp-action="Demo">Демо-доступы</a>
            </div>
        </section>
    </div>

    <section class="zoo-card">
        <h2>Структура решения</h2>
        <pre class="zoo-code">ZooStav.sln
├── src/
│   ├── ZooStav.Web/                    ASP.NET Core MVC + REST API + Identity + JWT
│   │   ├── Controllers/                MVC-контроллеры (страницы)
│   │   ├── Controllers/Api/            REST API (Swagger)
│   │   ├── Data/ZooDbContext.cs        EF Core: пользователи, животные, медиа, дневник, донаты
│   │   ├── Domain/Entities.cs          сущности предметной области
│   │   ├── Infrastructure/             поддомен-роутинг, JWT-настройки, инициализация БД
│   │   ├── Mapping/                    сущность → DTO
│   │   ├── Services/                   DiaryService (фильтры), AuditService, Payment, JWT
│   │   ├── ViewModels/                 модели представлений и DTO
│   │   └── Views/                      Razor-представления
│   ├── ZooStav.Migrations.SqlServer/   миграции EF Core для SQL Server
│   └── ZooStav.Migrations.Sqlite/      миграции EF Core для SQLite
└── tests/ZooStav.Tests/                модульные тесты (фильтры дневника, поддомен-роутинг, API)</pre>
    </section>
</div>
